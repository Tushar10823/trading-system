# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# Get paper trading API keys:
#   1. Sign up at https://app.alpaca.markets/signup
#   2. Open Paper Trading dashboard → API Keys → Generate
#   3. Paste key + secret below
#
# WARNING: Use PAPER keys only. Do not put live/real-money keys here.

ALPACA_API_KEY=your_alpaca_paper_api_key
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key

# Paper trading REST endpoint (default — do not change unless you know why)
# LIVE trading would use https://api.alpaca.markets — never set that unless explicitly requested.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: used in later phases for Telegram BUY/SELL alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Phase 5.5 news scanner (can also live in repo-root .env)
# NEWS_API_KEY=your_newsapi_key
