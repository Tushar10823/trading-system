# Copy to .env and fill in your values:
#   copy .env.example .env

# PostgreSQL
POSTGRES_USER=trading
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=trading

# n8n basic auth (http://localhost:5678)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_this_password

# Market data APIs (free tiers)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key

# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key

# Alpaca paper trading: https://app.alpaca.markets/signup
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading config
DEFAULT_SYMBOLS=AAPL,MSFT
CONFIDENCE_THRESHOLD=70
OLLAMA_MODEL=llama3.2

# Next.js dashboard (reads same Postgres)
DATABASE_URL=postgresql://trading:change_this_password@localhost:5432/trading
